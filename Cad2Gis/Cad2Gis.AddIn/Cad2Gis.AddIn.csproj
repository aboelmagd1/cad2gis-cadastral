<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Cad2Gis.AddIn</RootNamespace>
    <AssemblyName>Cad2Gis.AddIn</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ArcGISProBinDir>C:\Program Files\ArcGIS\Pro\bin</ArcGISProBinDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cad2Gis.Core\Cad2Gis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <!-- ArcGIS Pro SDK Assembly References -->
  <ItemGroup>
    <Reference Include="ArcGIS.Core">
      <HintPath>$(ArcGISProBinDir)\ArcGIS.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.CoreHost">
      <HintPath>$(ArcGISProBinDir)\ArcGIS.CoreHost.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Framework">
      <HintPath>$(ArcGISProBinDir)\ArcGIS.Desktop.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Core">
      <HintPath>$(ArcGISProBinDir)\Extensions\Core\ArcGIS.Desktop.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Mapping">
      <HintPath>$(ArcGISProBinDir)\Extensions\Mapping\ArcGIS.Desktop.Mapping.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Catalog">
      <HintPath>$(ArcGISProBinDir)\Extensions\Catalog\ArcGIS.Desktop.Catalog.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Editing">
      <HintPath>$(ArcGISProBinDir)\Extensions\Editing\ArcGIS.Desktop.Editing.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.GeoProcessing">
      <HintPath>$(ArcGISProBinDir)\Extensions\GeoProcessing\ArcGIS.Desktop.GeoProcessing.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AddInContent Include="Config.daml" />
    <AddInContent Include="Images\**\*" />
    <Resource Include="Images\**\*" />
  </ItemGroup>

  <Import Project="$(ArcGISProBinDir)\Esri.ProApp.SDK.Desktop.targets" Condition="'$(MSBuildRuntimeType)' == 'Full' And Exists('$(ArcGISProBinDir)\Esri.ProApp.SDK.Desktop.targets')" />

</Project>
